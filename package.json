{
    "name": "thesis-template-master",
    "packageManager": "npm@11.18.0",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "lint": "being-textlint */*.tex",
        "fix": "being-textlint --fix */*.tex",
        "lint-style": "being-textlint -f checkstyle */*.tex",
        "mcp": "being-textlint --mcp"
    },
    "devDependencies": {
        "being-textlint-ja-latex": "https://github.com/being24/textlint-ja-latex/archive/refs/tags/v0.1.1.tar.gz"
    }
}
